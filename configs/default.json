{
  "data": {
    "dataset_path": "/content/drive/MyDrive/News_Category_Dataset_v3.json",
    "text_column": "description",
    "fallback_text_column": "short_description",
    "target_column": "headline",
    "test_size": 0.1,
    "seed": 42
  },
  "model": {
    "base_model": "facebook/bart-base",
    "max_input_length": 250,
    "max_target_length": 30,
    "lora": {
      "r": 8,
      "lora_alpha": 32,
      "lora_dropout": 0.1,
      "target_modules": ["q_proj", "v_proj"]
    }
  },
  "training": {
    "output_dir": "checkpoints/bart-lora-headline",
    "num_train_epochs": 5,
    "per_device_train_batch_size": 16,
    "per_device_eval_batch_size": 16,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "logging_steps": 100,
    "save_strategy": "epoch",
    "eval_strategy": "epoch",
    "predict_with_generate": true,
    "fp16": true,
    "label_smoothing_factor": 0.1,
    "report_to": []
  },
  "generation": {
    "max_new_tokens": 30,
    "num_beams": 4,
    "early_stopping": true,
    "batch_size": 16
  },
  "evaluation": {
    "results_path": "results/evaluation.json",
    "sample_predictions_path": "results/sample_predictions.jsonl",
    "num_sample_predictions": 25
  }
}
